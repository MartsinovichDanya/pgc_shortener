{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API сервиса сокращения ссылок.",
        "title": "PGC Shortener API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/": {
            "post": {
                "consumes": [
                    "text/plain"
                ],
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "links"
                ],
                "summary": "Создать короткую ссылку",
                "parameters": [
                    {
                        "description": "Оригинальный URL",
                        "name": "url",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Короткая ссылка",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Некорректный запрос",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "URL уже существует",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/shorten": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "links"
                ],
                "summary": "Создать короткую ссылку (JSON)",
                "parameters": [
                    {
                        "description": "Запрос",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.Request"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.Response"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "URL уже существует",
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.Response"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/shorten/batch": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "links"
                ],
                "summary": "Массовое создание коротких ссылок",
                "parameters": [
                    {
                        "description": "Список URL",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.BatchRequestItem"
                            }
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.BatchResponseItem"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/user/urls": {
            "get": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user"
                ],
                "summary": "Получить ссылки пользователя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.UserURL"
                            }
                        }
                    },
                    "204": {
                        "description": "Нет ссылок"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "CookieAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "user"
                ],
                "summary": "Удалить ссылки пользователя",
                "parameters": [
                    {
                        "description": "Список коротких идентификаторов",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Принято"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_MartsinovichDanya_pgc_shortener_internal_model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/ping": {
            "get": {
                "tags": [
                    "system"
                ],
                "summary": "Проверка соединения с БД",
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "500": {
                        "description": "Database ping failed",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/{id}": {
            "get": {
                "tags": [
                    "links"
                ],
                "summary": "Редирект на оригинальный URL",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Короткий идентификатор",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "307": {
                        "description": "Temporary Redirect"
                    },
                    "400": {
                        "description": "Некорректный запрос",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "410": {
                        "description": "Ссылка удалена",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_MartsinovichDanya_pgc_shortener_internal_model.BatchRequestItem": {
            "type": "object",
            "properties": {
                "correlation_id": {
                    "type": "string",
                    "example": "1"
                },
                "original_url": {
                    "type": "string",
                    "example": "https://example.com"
                }
            }
        },
        "github_com_MartsinovichDanya_pgc_shortener_internal_model.BatchResponseItem": {
            "type": "object",
            "properties": {
                "correlation_id": {
                    "type": "string",
                    "example": "1"
                },
                "short_url": {
                    "type": "string",
                    "example": "http://localhost:8080/abc123"
                }
            }
        },
        "github_com_MartsinovichDanya_pgc_shortener_internal_model.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Некорректный URL"
                }
            }
        },
        "github_com_MartsinovichDanya_pgc_shortener_internal_model.Request": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string",
                    "example": "https://example.com"
                }
            }
        },
        "github_com_MartsinovichDanya_pgc_shortener_internal_model.Response": {
            "type": "object",
            "properties": {
                "result": {
                    "type": "string",
                    "example": "http://localhost:8080/abc123"
                }
            }
        },
        "github_com_MartsinovichDanya_pgc_shortener_internal_model.UserURL": {
            "type": "object",
            "properties": {
                "original_url": {
                    "type": "string",
                    "example": "https://example.com"
                },
                "short_url": {
                    "type": "string",
                    "example": "http://localhost:8080/abc123"
                }
            }
        }
    },
    "securityDefinitions": {
        "CookieAuth": {
            "type": "apiKey",
            "name": "user_token",
            "in": "cookie"
        }
    }
}